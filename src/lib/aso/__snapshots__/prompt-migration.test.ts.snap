exports[`prompt characterization (pre-migration lock) > aso_translate_captions > user 1`] = `"{"captions":["Fast edits","Pro filters"]}"`;

exports[`prompt characterization (pre-migration lock) > aso_translate_keywords > system 1`] = `
"You translate App Store / Google Play SEARCH keywords into the language "fr-FR".
Each item is a short term users type to find an app. Give the natural, idiomatic search term a native speaker of "fr-FR" would actually type, NOT a literal word-for-word translation.
Keep brand names and proper nouns untranslated. Keep each translation short (1-3 words), lowercase.
If an input term is already a natural search term in "fr-FR", or is a brand name or proper noun, return it unchanged.
Respond ONLY in JSON: {"translations": string[]} with EXACTLY one entry per input keyword, in the SAME order. Never drop, add, or reorder items."
`;

exports[`prompt characterization (pre-migration lock) > aso_translate_keywords > user 1`] = `
"Translate these 2 keywords into "fr-FR", preserving order:
1. video editing
2. filter"
`;

