# ==============================================================================
# ASOFAST — Environment Variables (100% local)
# ==============================================================================
# Copy this file to `.env.local` and fill in the values.
# No external services required: the project runs entirely locally (SQLite +
# files). Only ASO generation calls OpenAI, with YOUR API key.
# ==============================================================================

# ------------------------------------------------------------------------------
# OpenAI (ASO generation: copy, translations, screenshots)
# ------------------------------------------------------------------------------
# Your OpenAI API key. Used by the local server only.
# Create a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Optional model overrides (default: gpt-4o). The vision model analyzes
# competitor screenshots to extract their style.
# OPENAI_MODEL="gpt-4o"
# OPENAI_VISION_MODEL="gpt-4o"


# ------------------------------------------------------------------------------
# Local server (optional)
# ------------------------------------------------------------------------------
# Server port (default: 3000).
# PORT=3000