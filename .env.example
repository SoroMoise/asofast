# ==============================================================================
# ASOFAST — Environment Variables (100% local)
# ==============================================================================
# Copy this file to `.env.local` and fill in the values.
# No external services required: the project runs entirely locally (SQLite +
# files). Only ASO generation calls an LLM provider, with YOUR API key.
# ==============================================================================

# ------------------------------------------------------------------------------
# AI provider (ASO generation: copy, translations, screenshots)
# ------------------------------------------------------------------------------
# Which provider to use: "openai", "anthropic" or "deepseek". Optional — if
# unset (or set to anything else), OpenAI is used (default, unchanged behavior).
# AI_PROVIDER="openai"

# --- OpenAI ---
# Your OpenAI API key. Used by the local server only.
# Create a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Optional model overrides (default: gpt-4o). The vision model analyzes
# competitor screenshots to extract their style.
# OPENAI_MODEL="gpt-4o"
# OPENAI_VISION_MODEL="gpt-4o"

# --- Anthropic (used only when AI_PROVIDER="anthropic") ---
# Your Anthropic API key. Create one at: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional model overrides (default: claude-sonnet-5).
# ANTHROPIC_MODEL="claude-sonnet-5"
# ANTHROPIC_VISION_MODEL="claude-sonnet-5"

# --- DeepSeek (used only when AI_PROVIDER="deepseek") ---
# Your DeepSeek API key. Create one at: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY="sk-..."

# Optional model overrides. DEEPSEEK_MODEL (default: deepseek-flash) handles all
# text calls; you can set "deepseek-v4-pro" for quality. The vision model
# (default: deepseek-flash) analyzes screenshots and must support images:
# deepseek-v4-pro does NOT, and answers "cannot read image" instead of failing.
# DEEPSEEK_MODEL="deepseek-flash"
# DEEPSEEK_VISION_MODEL="deepseek-flash"


# ------------------------------------------------------------------------------
# Local server (optional)
# ------------------------------------------------------------------------------
# Server port (default: 3000).
# PORT=3000